#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char str[1000];
    
    // Read the full name including spaces
    if (scanf("%[^\n]", str) != 1) {
        return 0;
    }
    
    int length = strlen(str);
    
    // Print the initial of the first name if the string is not empty
    if (length > 0 && str[0] != ' ') {
        printf("%c.", toupper(str[0]));
    }
    
    // Traverse the rest of the string to find initials after spaces
    for (int i = 1; i < length; i++) {
        // If the current character is a space and the next character is a valid letter
        if (str[i - 1] == ' ' && str[i] != ' ' && str[i] != '\0') {
            printf("%c.", toupper(str[i]));
        }
    }
    
    printf("\n");
    
    return 0;
}
