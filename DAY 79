#include <stdio.h>
#include <ctype.h>

int main() {
    char str[1000];
    
    // Read the input string including spaces if any
    if (scanf("%[^\n]", str) != 1) {
        printf("Vowels=0, Consonants=0\n");
        return 0;
    }
    
    int vowels = 0;
    int consonants = 0;
    
    int i = 0;
    while (str[i] != '\0') {
        char ch = tolower(str[i]);
        
        // Check if the character is an alphabet letter
        if (ch >= 'a' && ch <= 'z') {
            if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u') {
                vowels++;
            } else {
                consonants++;
            }
        }
        i++;
    }
    
    // Print Output matching the format requirement
    printf("Vowels=%d, Consonants=%d\n", vowels, consonants);
    
    return 0;
}
