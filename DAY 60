// SEARCH FOR AN ELEMENT IN AN ARRAY LINEAR SEARCH //


#include<stdio.h>
int main() {
int n;

if(scanf("%d", &n) != 1 || n <= 0) {
return 0;
}

int arr[n];

for(int i = 0; i < n ; i++) {
scanf("%d", &arr[i]);

}

int target ;
scanf("%d" , &target);

int found index = -1;
for(int i = 0; i < n; i++) {
if (arr[i] == target) {
found index = i;
break;
}
}

if(found index != -1) {
printf("Found at index %d\n", found index);
}
else {
printf("-1\n");
}
return 0;
}
