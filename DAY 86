#include <stdio.h>

int main() {
    char str[1000];
    
    // Read the input string including spaces if any
    if (scanf("%[^\n]", str) != 1) {
        return 0;
    }
    
    int i = 0;
    // Iterate through the string until the null-terminating character '\0'
    while (str[i] != '\0') {
        // Check if the character is lowercase ('a' to 'z')
        if (str[i] >= 'a' && str[i] <= 'z') {
            str[i] = str[i] - 32; // Convert to uppercase
        }
        // Check if the character is uppercase ('A' to 'Z')
        else if (str[i] >= 'A' && str[i] <= 'Z') {
            str[i] = str[i] + 32; // Convert to lowercase
        }
        i++;
    }
    
    // Print the modified string
    printf("%s\n", str);
    
    return 0;
}
