#include <stdio.h>
#include <math.h>

int main() {
    long long n;
    if (scanf("%lld", &n) != 1 || n < 1) {
        printf("-1\n");
        return 0;
    }

    long long total_sum = n * (n + 1) / 2;
    long long x = (long long)sqrt((double)total_sum);

    if (x * x == total_sum) {
        printf("%lld\n", x);
    } else {
        printf("-1\n");
    }

    return 0;
}
