// COUNT POSTIIVE , NEGATIVE , AND ZERO ELEMENT IN AN ARRAY // 


#include<stdio.h>

int main() {
int n ;

if(scanf("%d", &n) != 1 || n <= 0 ) {
return 0;

}

int arr[n];
int positive count = 0;
int negative count = 0;
int zero count = 0;

for(int i = 0; i < n; i++ ) {
scanf("%d" , &arr[i]);

if (arr[i] > 0) {
postive count++;
}
else if (arr[i] < 0) {
negative count++;
}
else {
zero count++; }
}

