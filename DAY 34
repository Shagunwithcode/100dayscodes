/*
Problem: Q37 (Loops without Arrays/Strings)
Write a program to find the LCM of two numbers.

Sample Test Cases:
Input 1: 4 5
Output 1: 20

Input 2: 7 3
Output 2: 21
*/

#include <stdio.h>

int main() {
    int a, b, max;
    
    // Read the two input numbers
    scanf("%d %d", &a, &b);
    
    // Find the maximum of the two numbers to start our check
    max = (a > b) ? a : b;
    
    // Loop indefinitely until we find the LCM
    while (1) {
        if (max % a == 0 && max % b == 0) {
            printf("%d\n", max);
            break;
        }
        max++;
    }
    
    return 0;
}
