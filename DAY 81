#include <stdio.h>
#include <string.h>

int main() {
    char str[1000];
    
    // Read the input string including spaces if any
    if (scanf("%[^\n]", str) != 1) {
        return 0;
    }
    
    int length = 0;
    // Find the length of the string manually
    while (str[length] != '\0') {
        length++;
    }
    
    // Swap characters from the two ends towards the center
    int start = 0;
    int end = length - 1;
    while (start < end) {
        char temp = str[start];
        str[start] = str[end];
        str[end] = temp;
        
        start++;
        end--;
    }
    
    // Print the reversed string
    printf("%s\n", str);
    
    return 0;
}
