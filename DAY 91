#include <stdio.h>
#include <string.h>
#include <stdbool.h>

int main() {
    char str1[1000], str2[1000];
    
    // Read both strings
    if (scanf("%s", str1) != 1) return 0;
    if (scanf("%s", str2) != 1) return 0;
    
    int count[256] = {0}; // Frequency array for ASCII characters
    
    int len1 = strlen(str1);
    int len2 = strlen(str2);
    
    // If lengths are different, they cannot be anagrams
    if (len1 != len2) {
        printf("Not anagrams\n");
        return 0;
    }
    
    // Increment frequency for characters in the first string,
    // and decrement for characters in the second string
    for (int i = 0; i < len1; i++) {
        count[(unsigned char)str1[i]]++;
        count[(unsigned char)str2[i]]--;
    }
    
    bool isAnagram = true;
    
    // If all counts are zero, the strings are anagrams
    for (int i = 0; i < 256; i++) {
        if (count[i] != 0) {
            isAnagram = false;
            break;
        }
    }
    
    // Print the final result
    if (isAnagram) {
        printf("Anagrams\n");
    } else {
        printf("Not anagrams\n");
    }
    
    return 0;
}
