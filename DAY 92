
#include <stdio.h>
#include <string.h>
#include <stdbool.h>

int main() {
    char str1[1000], str2[1000];
    
    // Read both input strings
    if (scanf("%s", str1) != 1) return 0;
    if (scanf("%s", str2) != 1) return 0;
    
    int len1 = strlen(str1);
    int len2 = strlen(str2);
    
    // If lengths are different, str2 cannot be a rotation of str1
    if (len1 != len2) {
        printf("Not rotation\n");
        return 0;
    }
    
    // Concatenate str1 with itself to cover all rotation combinations
    char temp[2005];
    strcpy(temp, str1);
    strcat(temp, str1);
    
    // Check if str2 is a substring of (str1 + str1)
    if (strstr(temp, str2) != NULL) {
        printf("Rotation\n");
    } else {
        printf("Not rotation\n");
    }
    
    return 0;
}
