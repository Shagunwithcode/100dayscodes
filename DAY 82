#include <stdio.h>
#include <string.h>
#include <stdbool.h>

int main() {
    char str[1000];
    
    // Read the input string including spaces if any
    if (scanf("%[^\n]", str) != 1) {
        return 0;
    }
    
    int length = 0;
    // Find the length of the string manually
    while (str[length] != '\0') {
        length++;
    }
    
    bool isPalindrome = true;
    int start = 0;
    int end = length - 1;
    
    // Compare characters from both ends moving towards the center
    while (start < end) {
        if (str[start] != str[end]) {
            isPalindrome = false;
            break;
        }
        start++;
        end--;
    }
    
    // Print the output according to the requirement
    if (isPalindrome) {
        printf("Palindrome\n");
    } else {
        printf("Not palindrome\n");
    }
    
    return 0;
}
