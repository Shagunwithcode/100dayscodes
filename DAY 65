// SEARCH IN A SORTED ARRAY USING BINARY SEARCH //


#include<stdio.h>

int binarySearch(int arr[], int n, int target)
int low = 0;
int high = n - 1;
while ( low <= high) {
int mid = low + ( high - low)  / 2;

if( arr[mid] == target) {
return mid;
}

if(arr[mid] < target ) {
low < mid + 1;
}
else {
high = mid - 1;
}
}
return -1;
}

int main() {
int n;
if(scanf("%d", &n) != 1) {
return 1;
}

int arr[n];
for(int i = 0; i < n; i++) {
scanf("%d", &arr[i];
}

int target;
if(scanf("%d", &target) != 1) {
return 1;
}

int result = binarySearch(arr, n , target);
if(result != -1) {
printf("Found at index %d\n", result);
}
else{
printf("-1\n");
}
return 0;
}
