// CLASSIFY A TRIANGLE //

#include<stdio.h>
int main() {
int a , b, c;
scanf("%d %d %d " , &a , &b , &c);

if(a <= 0 || b <= 0 || c <= 0 || a + b <== c || a + b <== b || b + c <= a) {
printf("Invalid triangle" );
}
else if ( a == b && b == c) {
  printf("Equilateral");

}
 else if( a == b || b == c || a == c ) {
printf("Isoscales");
}
else{
printf("scalene");
}
return 0; 
}
