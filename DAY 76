#include <stdio.h>

int main() {
    int r1, c1, r2, c2;
    
    // Read dimensions of the first matrix
    if (scanf("%d %d", &r1, &c1) != 2) return 0;
    
    int mat1[r1][c1];
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c1; j++) {
            scanf("%d", &mat1[i][j]);
        }
    }
    
    // Read dimensions of the second matrix
    if (scanf("%d %d", &r2, &c2) != 2) return 0;
    
    int mat2[r2][c2];
    for (int i = 0; i < r2; i++) {
        for (int j = 0; j < c2; j++) {
            scanf("%d", &mat2[i][j]);
        }
    }
    
    // Check if matrix multiplication is possible
    if (c1 != r2) {
        printf("Matrix multiplication not possible. Columns of first must match rows of second.\n");
        return 0;
    }
    
    // Resultant matrix of dimensions r1 x c2
    int result[r1][c2];
    
    // Initialize result matrix elements to 0
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            result[i][j] = 0;
        }
    }
    
    // Perform matrix multiplication
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            for (int k = 0; k < c1; k++) {
                result[i][j] += mat1[i][k] * mat2[k][j];
            }
        }
    }
    
    // Print the resultant matrix
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            printf("%d", result[i][j]);
            if (j < c2 - 1) {
                printf(" ");
            }
        }
        printf("\n");
    }
    
    return 0;
}
