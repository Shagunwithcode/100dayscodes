#include <stdio.h>
#include <stdlib.h>

typedef struct {
    char name[100];
    int roll;
    int marks;
} Student;

int main() {
    int n;
    FILE *filePointer;

    printf("Enter number of students: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Error: Invalid number of students.\n");
        return 1;
    }

    Student *students = malloc((size_t)n * sizeof(Student));
    if (students == NULL) {
        printf("Error: Memory allocation failed.\n");
        return 1;
    }

    // Collect student records from user input
    for (int i = 0; i < n; i++) {
        printf("\nStudent %d:\n", i + 1);
        printf("Name: ");
        scanf("%99s", students[i].name);

        printf("Roll: ");
        scanf("%d", &students[i].roll);

        printf("Marks: ");
        scanf("%d", &students[i].marks);
    }

    // Write records to students.txt using fprintf()
    filePointer = fopen("students.txt", "w");
    if (filePointer == NULL) {
        printf("Error: Could not open students.txt for writing.\n");
        free(students);
        return 1;
    }

    for (int i = 0; i < n; i++) {
        fprintf(filePointer, "%s %d %d\n",
                students[i].name, students[i].roll, students[i].marks);
    }

    fclose(filePointer);

    // Read records back from students.txt using fscanf() and display them
    filePointer = fopen("students.txt", "r");
    if (filePointer == NULL) {
        printf("Error: Could not open students.txt for reading.\n");
        free(students);
        return 1;
    }

    printf("\nStored Student Records:\n");
    Student temp;
    while (fscanf(filePointer, "%99s %d %d", temp.name, &temp.roll, &temp.marks) == 3) {
        printf("Name: %s | Roll: %d | Marks: %d\n", temp.name, temp.roll, temp.marks);
    }

    fclose(filePointer);
    free(students);

    return 0;
}
