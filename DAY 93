#include <stdio.h>
#include <string.h>

// Helper function to reverse a substring in-place from start to end index
void reverse(char str[], int start, int end) {
    while (start < end) {
        char temp = str[start];
        str[start] = str[end];
        str[end] = temp;
        start++;
        end--;
    }
}

int main() {
    char str[1000];
    
    // Read the input sentence including spaces
    if (scanf("%[^\n]", str) != 1) {
        return 0;
    }
    
    int length = strlen(str);
    int start = 0;
    
    // Traverse the string to find word boundaries
    for (int i = 0; i <= length; i++) {
        // When we hit a space or the end of the string, it marks the end of a word
        if (str[i] == ' ' || str[i] == '\0') {
            reverse(str, start, i - 1);
            // Move the start pointer to the beginning of the next word
            start = i + 1;
        }
    }
    
    // Print the modified sentence
    printf("%s\n", str);
    
    return 0;
}#include <stdio.h>
