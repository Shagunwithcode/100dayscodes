// THE BINARY REPRESENTATION OF A GIVEN NUMBER //

#include<stdio.h>
int main() {
void printbinary(int n ) {
if ( n== 0 ) {
printf("0");
return; 
}
int binary[32];
int index = 0;
while ( n > 0 ) {
binary[index] = n % 2;
n = n / 2;
}
for( int i = index - 1 ; i >= 0; i-- ) {
printf("%d", binary[i]) 
}
}
int main() {
int n;
scanf("%d", &n);
printbinary(n); 
return 0; 
}
