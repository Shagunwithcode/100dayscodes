#include <stdio.h>

void mergeSortedArrays(const int nums1[], int m, const int nums2[], int n, int merged[]) {
    int i = 0, j = 0, k = 0;

    while (i < m && j < n) {
        if (nums1[i] <= nums2[j]) {
            merged[k++] = nums1[i++];
        } else {
            merged[k++] = nums2[j++];
        }
    }

    while (i < m) {
        merged[k++] = nums1[i++];
    }

    while (j < n) {
        merged[k++] = nums2[j++];
    }
}

int main() {
    int m, n;

    if (scanf("%d", &m) != 1 || m < 0) {
        return 0;
    }
    int nums1[m > 0 ? m : 1];
    for (int i = 0; i < m; i++) {
        scanf("%d", &nums1[i]);
    }

    if (scanf("%d", &n) != 1 || n < 0) {
        return 0;
    }
    int nums2[n > 0 ? n : 1];
    for (int j = 0; j < n; j++) {
        scanf("%d", &nums2[j]);
    }

    int total = m + n;
    int merged[total > 0 ? total : 1];
    mergeSortedArrays(nums1, m, nums2, n, merged);

    for (int k = 0; k < total; k++) {
        if (k > 0) {
            printf(" ");
        }
        printf("%d", merged[k]);
    }
    printf("\n");

    return 0;
}
