// TO FIND THE SUM OF THE GIVEN SERIES UP TO N TEREM//


#include<stdio.h>
int main(){
int n;
double sum = 0.0;

scanf("%d" , &n);
for( int i = 1; i <= n; i++ ) {
double numerator = 2.0 * i;
double denominator = ( 4.0 * i) - 1.0;

sum += numertor / denominator ;
}

printf(" Approximate sum : %.2f\n" , sum);
