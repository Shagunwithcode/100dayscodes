#include <stdio.h>
#include <string.h>

enum Status {
    SUCCESS,
    FAILURE,
    TIMEOUT,
    INVALID
};

enum Status parseStatus(const char *str) {
    if (strcmp(str, "SUCCESS") == 0) return SUCCESS;
    if (strcmp(str, "FAILURE") == 0) return FAILURE;
    if (strcmp(str, "TIMEOUT") == 0) return TIMEOUT;
    return INVALID;
}

void printStatusMessage(enum Status s) {
    switch (s) {
        case SUCCESS:
            printf("Operation successful\n");
            break;
        case FAILURE:
            printf("Operation failed\n");
            break;
        case TIMEOUT:
            printf("Operation timed out\n");
            break;
        default:
            printf("Invalid status\n");
            break;
    }
}

int main() {
    char input[20];
    if (scanf("%19s", input) == 1) {
        enum Status s = parseStatus(input);
        printStatusMessage(s);
    }
    return 0;
}
