#include <stdio.h>

int main() {
    int n, k;

    printf("Enter number of elements: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        return 0;
    }

    int arr[n];
    printf("Enter %d elements: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter window size k: ");
    if (scanf("%d", &k) != 1 || k <= 0 || k > n) {
        return 0;
    }

    // Slide window of size k from left to right
    for (int i = 0; i <= n - k; i++) {
        int maxVal = arr[i];
        for (int j = i + 1; j < i + k; j++) {
            if (arr[j] > maxVal) {
                maxVal = arr[j];
            }
        }
        printf("%d", maxVal);
        if (i < n - k) {
            printf(" ");
        }
    }
    printf("\n");

    return 0;
}
