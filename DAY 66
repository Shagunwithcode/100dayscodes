// INSERT AN ELEMENT IN A SORTED ARRAY AT THE APPROPRIATE POSTION //


#include<stdio.h>
int main() {
int n;

if(scanf("%d", &n) != 1) {
return 1;
}

int arr[n + 1];

for( int i = 0; i < n; i++) {
scanf("%d", &arr[i]);
}

int element;
if(scanf("%d", &element) != 1) {
return 1;
}

int i = n -1;
while ( i >= 0 && arr[i] >  element) {
arr[i + 1] = arr[i];
i--;
}

arr[i + 1] = element;

for(int j = 0; j <= n; j++0 ) {
printf("%d",arr[j]);
if(j < n ) {
printf(" " ) ;
}
}
printf("\n");
return 0;
}

