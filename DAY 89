#include <stdio.h>
#include <string.h>

int main() {
    char str[1000];
    
    // Read the input string including spaces if any
    if (scanf("%[^\n]", str) != 1) {
        return 0;
    }
    
    char firstRepeating = '\0';
    
    // Iterate through each character to find the first repeating lowercase letter
    int len = strlen(str);
    for (int i = 0; i < len; i++) {
        // Consider only lowercase alphabets
        if (str[i] >= 'a' && str[i] <= 'z') {
            int isRepeated = 0;
            // Check subsequent characters for a match
            for (int j = i + 1; j < len; j++) {
                if (str[i] == str[j]) {
                    isRepeated = 1;
                    break;
                }
            }
            if (isRepeated) {
                firstRepeating = str[i];
                break;
            }
        }
    }
    
    // Print the result if found
    if (firstRepeating != '\0') {
        printf("%c\n", firstRepeating);
    }
    
    return 0;
}
