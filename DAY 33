// TO FIND HCF OF TWO NUMBER USING THE EUCLIDEAN ALGROITHM 

#include<stdio.h>
int main() {
int findhcf(int a , int b) {
while ( b != 0 ) {
int temp = b;
b = a % b;
a = temp;
  }
return 0;
}
int main() {
int num1 , num2;
scanf("%d %d\n" , &num1 , &num2);
int hcf = findHCF( num1, num2):
printf("%d\n", hcf);
