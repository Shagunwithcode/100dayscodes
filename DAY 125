#include <stdio.h>
#include <stdlib.h>

int findRepeatedElement(const int nums[], int n) {
    if (n <= 0) {
        return -1;
    }

    int max_val = nums[0];
    for (int i = 1; i < n; i++) {
        if (nums[i] > max_val) {
            max_val = nums[i];
        }
    }

    if (max_val < 0) {
        return -1;
    }

    int *seen = (int *)calloc((size_t)max_val + 1, sizeof(int));
    if (seen == NULL) {
        return -1;
    }

    int repeated = -1;

    // Single pass to detect the repeated element as soon as it is seen a second time
    for (int i = 0; i < n; i++) {
        int val = nums[i];
        if (val >= 0 && seen[val]) {
            repeated = val;
            break;
        }
        seen[val] = 1;
    }

    free(seen);
    return repeated;
}

int main() {
    int n;

    if (scanf("%d", &n) != 1 || n <= 0) {
        return 0;
    }

    int *nums = (int *)malloc((size_t)n * sizeof(int));
    if (nums == NULL) {
        return 0;
    }

    for (int i = 0; i < n; i++) {
        if (scanf("%d", &nums[i]) != 1) {
            free(nums);
            return 0;
        }
    }

    int ans = findRepeatedElement(nums, n);
    if (ans != -1) {
        printf("%d\n", ans);
    }

    free(nums);
    return 0;
}
