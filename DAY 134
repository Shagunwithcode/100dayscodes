#include <stdio.h>

int main() {
    FILE *filePointer;
    int num;
    long long sum = 0;
    int count = 0;

    // Open numbers.txt in read mode
    filePointer = fopen("numbers.txt", "r");
    if (filePointer == NULL) {
        printf("Error: Could not open numbers.txt!\n");
        return 1;
    }

    // Read integers separated by whitespace until EOF
    while (fscanf(filePointer, "%d", &num) == 1) {
        sum += num;
        count++;
    }

    fclose(filePointer);

    if (count == 0) {
        printf("No integers found in numbers.txt.\n");
        return 0;
    }

    double average = (double)sum / count;

    printf("Sum = %lld\n", sum);
    printf("Average = %.2f\n", average);

    return 0;
}
