if(scanf("%d %d" , &rows, &cols) != 2 ) {
return 0;
}

int matrix[rows][cols];
int row_sums[rows];

for(int i = 0; i < rows; i++0 {
rows_sums[i] = 0; 
for(int j = 0; j < cols; j++) {
scanf("%d" , &matrix[i][j]);
row_sums[i] += matrix[i][j];
}
}

for(int i = 0; i < rows; i++) {
