// LIBARY FINE CALCULATION//

#include<stdio.h>
  int main(){
  int days , fine ;
  scanf("%d" , &days);

  if (days < 0) {
    printf("Invalid days" );
  }
  else if (days > 30) {
    printf("Membership cancelled " );
  }
  else if ( days <= 5 ) {
    fine = days * 2;
    printf("Fine %d", fine);
  }
  else {
    fine = 5 * 2 + 5 * 4 + ( days - 10 ) * 6;
    printf("Fine %d " , fine );
  }
  return 0;
}
