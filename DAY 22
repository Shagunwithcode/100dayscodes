// BASIC CALCULATOR USING SWITCH CASE //

#include <stdio.h>
int main() {
int a , b;
char op;
scanf("%d %d %c" ; &a , &b , &op);

switch(op) {
case '+':
printf("%d" , a + b);
break;

case '-' :
printf("%d" , a - b);
break;

case '*':
printf("%d", a * b);
break;

case '/' :
if(b =! 0 ) {
print("%d", a / b);
break;
}
else {
printf("Divison by zero ");
}
break;
case '%' :
if (b !=0) {
printf("%d", a % b );
}
default:
printf("Invalid opertor " );
}
return 0;
}
