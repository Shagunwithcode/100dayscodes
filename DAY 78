#include <stdio.h>

int main() {
    char str[1000];
    
    // Read the input string including spaces if any
    if (scanf("%[^\n]", str) != 1) {
        return 0;
    }
    
    int i = 0;
    // Iterate through the string until the null-terminating character '\0'
    while (str[i] != '\0') {
        printf("%c\n", str[i]);
        i++;
    }
    
    return 0;
}
