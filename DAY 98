#include <stdio.h>

// Function to find the index of the ceil of x
int findCeilIndex(int arr[], int n, int x) {
    int low = 0, high = n - 1;
    int ans = -1;
    
    while (low <= high) {
        int mid = low + (high - low) / 2;
        
        // If the current element is greater than or equal to x,
        // it is a potential ceil. Record the index and look to the left
        // for any earlier occurrences.
        if (arr[mid] >= x) {
            ans = mid;
            high = mid - 1;
        } else {
            // If arr[mid] is less than x, the ceil must be to the right
            low = mid + 1;
        }
    }
    
    return ans;
}

int main() {
    int n, x;
    
    // Read the size of the array
    if (scanf("%d", &n) != 1) return 0;
    
    int arr[n];
    // Read the sorted array elements
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    // Read the integer x
    scanf("%d", &x);
    
    // Find the index of the ceil of x
    int ceilIndex = findCeilIndex(arr, n, x);
    
    // Print the result
    printf("%d\n", ceilIndex);
    
    return 0;
}
