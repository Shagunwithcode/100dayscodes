// MERGE TWO ARRAYS //



#include<stdio.h>
int main () {
int n1 , n2 ;


if(scanf("%d", &n1) != 1 || n1 <= 0) {

return 0;
}

int arr1[n1];
for(int i = 0; i < n1; i++) {
scanf("%d", &arr1[i]);
}

if(scanf("%d", &n2) != 1 || n2 <= 0) {
return 0;
}

int arr2[n2];
for(int i = 0; i < n2 ; i++) {
scanf("%d", &arr2[i]);
}

int merged size = n1 + n2 ;
int merged[merged size ] ;
for ( int i = 0; i < n1; i++) {
merged[i] = arr1[i];
}

for(int i = 0 ; i < n1; i++0 {
merged[i] = arr1[i];
}

for(int i = 0 ; i < n2; i++) {
merged[n1 + 1 ] = arr2[i];

}

for(int i = 0; i < merged size ; i++) {
printf("%d" , merged[i]);
if(i < merged size - 1 ) {
printf(" " );
}
}
printf("\n");
return 0;
}
